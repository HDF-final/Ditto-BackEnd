# copy: .env.example → .env  후 값을 채운다.
ORACLE_JDBC_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
ORACLE_USERNAME=DITTO
ORACLE_PASSWORD=CHANGE_ME

# Gemini API
GEMINI_API_KEY=CHANGE_ME

# AI 엔진 — 로컬 파이썬 서비스 또는 Lambda Function URL
# 운영 예) AI_ENGINE_BASE_URL=https://xxxxxxxx.lambda-url.ap-northeast-2.on.aws  (끝에 / 없이)
#          AI_ENGINE_CHAT_PATH=/
#          AI_ENGINE_AUTH=aws-iam
AI_ENGINE_BASE_URL=http://127.0.0.1:8000
AI_ENGINE_CHAT_PATH=/chat
# none | aws-iam — Function URL 이 AuthType=AWS_IAM 이면 aws-iam.
# 자격증명은 EC2 인스턴스 역할에서 나오므로 액세스 키는 여기에 넣지 않는다.
AI_ENGINE_AUTH=none

# S3 이미지 저장소 (자격증명은 AWS profile 또는 EC2 IAM Role 사용)
AWS_S3_BUCKET=hdf-ditto-images
AWS_REGION=ap-northeast-2
AWS_S3_PREFIX=images
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_PRESIGNED_URL_EXPIRATION=30m

# Docker Compose / ECR
ECR_REGISTRY={}.dkr.ecr.ap-northeast-2.amazonaws.com
ECR_REPOSITORY=ditto-backend
IMAGE_TAG=latest

# AWS RDS PostgreSQL (RAG 계층)
PG_HOST=CHANGE_ME.rds.amazonaws.com
PG_USER=postgres
PG_PASSWORD=CHANGE_ME
PG_DATABASE=postgres
PG_SSLMODE=require
