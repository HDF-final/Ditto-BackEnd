# copy: .env.example → .env  후 값을 채운다.
ORACLE_JDBC_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
ORACLE_USERNAME=DITTO
ORACLE_PASSWORD=CHANGE_ME

# Gemini API
GEMINI_API_KEY=CHANGE_ME

# AI 엔진 — 로컬은 파이썬 서비스(http), 배포 환경은 Lambda 직접 호출(lambda)
# 운영 예) AI_ENGINE_MODE=lambda
#          AI_ENGINE_FUNCTION_NAME=ditto-chat-v2
# lambda 모드는 액세스 키가 필요 없다. EC2 인스턴스 역할에
# lambda:InvokeFunction 권한만 있으면 SDK 가 알아서 서명한다.
# AI_ENGINE_ENGINE 은 비워 두면 엔진 기본값(tavily). builtin 으로 되돌릴 수 있다.
AI_ENGINE_MODE=http
AI_ENGINE_BASE_URL=http://127.0.0.1:8000
AI_ENGINE_CHAT_PATH=/chat
AI_ENGINE_FUNCTION_NAME=ditto-chat-v2
AI_ENGINE_ENGINE=

# 승인 대기 코스 초안 (관리자 조회 전용) — 이쪽은 항상 Lambda 직접 호출이다.
# 초안 창구는 Lambda 안에서만 열리는 Redis 를 보므로 로컬에 띄울 대체물이 없다.
# 액세스 키는 필요 없다. AWS profile 또는 EC2 인스턴스 역할에
# lambda:InvokeFunction 권한만 있으면 된다.
CELEB_DRAFT_FUNCTION_NAME=ditto-celeb-warm-2

# 코스 승인 람다 (관리자가 초안을 손님 캐시로 올릴 때 부른다)
CELEB_APPROVE_FUNCTION_NAME=ditto-celeb-approve

# CORS 허용 오리진 (쉼표로 구분). 비워 두면 배포 도메인 + localhost:3000 이 기본이다.
# localhost:3000 은 프론트를 로컬에서 띄운 채 배포된 백엔드를 볼 때만 쓴다.
# 로컬 개발이 끝나면 배포 도메인만 남기고 좁힌다.
CORS_ALLOWED_ORIGINS=https://ditto-global.com,http://localhost:3000

# 실내 지도 원장 자산(CloudFront course-resource/*). 비우면 프론트가 자기 public/ 사본을 쓴다.
MAP_ASSET_BASE_URL=https://d1bxld598du04o.cloudfront.net/course-resource/navigation/v2
MAP_ASSET_MAX_AGE=1814400

# S3 이미지 저장소 (자격증명은 AWS profile 또는 EC2 IAM Role 사용)
AWS_S3_BUCKET=hdf-ditto-images
AWS_REGION=ap-northeast-2
AWS_S3_PREFIX=images
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_PRESIGNED_URL_EXPIRATION=30m

# Amazon Translate 동적 콘텐츠 번역
# access key를 넣지 않는다. 로컬 AWS profile 또는 EC2 IAM Role을 사용한다.
# Oracle 마이그레이션 적용 뒤 운영 환경에서 true로 켠다.
AWS_TRANSLATE_ENABLED=false
AWS_TRANSLATE_REGION=ap-northeast-2
AWS_TRANSLATE_MAX_REQUEST_BYTES=9000
AWS_TRANSLATE_PENDING_LEASE=2m
AWS_TRANSLATE_RETRY_BASE=5m
AWS_TRANSLATE_RETRY_MAX=24h

# Docker Compose / ECR
ECR_REGISTRY={}.dkr.ecr.ap-northeast-2.amazonaws.com
ECR_REPOSITORY=ditto-backend
IMAGE_TAG=latest

# AWS RDS PostgreSQL (RAG 계층)
PG_HOST=CHANGE_ME.rds.amazonaws.com
PG_USER=postgres
PG_PASSWORD=CHANGE_ME
PG_DATABASE=postgres
PG_SSLMODE=require
