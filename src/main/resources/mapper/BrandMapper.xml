<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ditto.brand.repository.BrandMapper">

    <sql id="brandColumns">
        b.brand_id,
        b.name,
        b.logo_url
    </sql>

    <select id="findAllActive"
            resultType="com.ditto.brand.repository.BrandMapper$BrandRow">
        SELECT <include refid="brandColumns" />
          FROM brand b
         WHERE b.status = 'ACTIVE'
         ORDER BY b.brand_id
    </select>

    <select id="findById"
            resultType="com.ditto.brand.repository.BrandMapper$BrandRow">
        SELECT <include refid="brandColumns" />
          FROM brand b
         WHERE b.brand_id = #{brandId}
    </select>

</mapper>
