<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ditto.country.repository.CountryMapper">

    <resultMap id="CountryRowMap" type="com.ditto.country.repository.CountryRow">
        <id property="countryId" column="country_id" />
        <result property="code" column="code" />
        <result property="defaultLanguageCode" column="default_language_code" />
    </resultMap>

    <select id="findActiveByCode" parameterType="string" resultMap="CountryRowMap">
        SELECT country_id,
               code,
               default_language_code
          FROM country
         WHERE code = #{_parameter}
           AND status = 'ACTIVE'
    </select>
</mapper>
