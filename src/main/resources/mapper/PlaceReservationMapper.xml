<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ditto.aicourse.repository.PlaceReservationMapper">

    <select id="findReservationByNavigationKey"
            resultType="com.ditto.aicourse.repository.PlaceReservationMapper$PlaceReservationRow">
        SELECT pl.name AS place_name,
               pl.catch_table_url
          FROM place pl
         WHERE pl.navigation_key = #{navigationKey}
           AND pl.catch_table_url IS NOT NULL
    </select>

</mapper>
