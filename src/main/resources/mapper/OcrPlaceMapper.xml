<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ditto.ocr.repository.OcrPlaceMapper">

    <select id="findNavigationKeyByPlaceId" resultType="java.lang.String">
        SELECT p.navigation_key
          FROM place p
         WHERE p.place_id = #{placeId}
           AND p.navigation_key IS NOT NULL
    </select>

    <!--
      OCR 매칭용 카탈로그. 오타를 LIKE 로 잡을 수 없고 REGEXP_REPLACE 를 행마다
      돌리는 비용도 커서, 길찾기 가능 장소를 한 번에 읽고 애플리케이션에서
      exact / alias / fuzzy 를 수행한다. 더현대 규모(약 100여 곳)에서는 인메모리가 맞다.
    -->
    <select id="findAllNavigablePlaces"
            resultType="com.ditto.ocr.repository.OcrPlaceMapper$CandidateRow">
        SELECT p.place_id,
               p.navigation_key AS navigationKey,
               p.name,
               f.floor_code AS floor
          FROM place p
          JOIN floor f ON f.floor_id = p.floor_id
         WHERE p.navigation_key IS NOT NULL
         ORDER BY p.name
    </select>

</mapper>
